# MedEasy Backend Environment Configuration

# Core AI & Speech APIs
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TINYFISH_API_KEY=
PHARMACY_CACHE_TTL_SECONDS=3600
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# YugabyteDB YSQL Connection
# Format for YugabyteDB Aeon: postgresql://<user>:<password>@<host>:5433/<dbname>?sslmode=require
# Format for local dev/testing: sqlite+aiosqlite:///medeasy_accounts.db (used as fallback when unset)
DATABASE_URL=

# Authentication & Security
# Generate secure secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (comma-separated)
MEDEASY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
